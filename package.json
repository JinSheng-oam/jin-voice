{
  "name": "jinvoice",
  "private": true,
  "version": "0.1.0",
  "description": "JinVoice voice room desktop client",
  "author": "JinVoice",
  "license": "MIT",
  "engines": {
    "node": ">=22.13 <23"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node script/dev.js",
    "dev:stable": "node script/dev-stable.js",
    "dev:hot": "node script/dev.js",
    "dev:client": "pnpm --prefix client run dev",
    "dev:server": "pnpm --prefix server run dev",
    "desktop:dev": "node script/desktop-dev.js",
    "desktop:pack": "pnpm --prefix client run build && electron-builder --dir",
    "desktop:build": "pnpm --prefix client run build && electron-builder --win nsis portable",
    "install:dev": "pnpm --prefix server install && pnpm --prefix client install",
    "test": "pnpm --prefix server test && pnpm --prefix client test",
    "verify": "node script/verify.js",
    "release": "node script/build.js",
    "scan:release": "node script/scan_release.js",
    "load:test": "node script/load-test.js"
  },
  "dependencies": {
    "node-global-key-listener": "^0.3.0"
  },
  "devDependencies": {
    "electron": "^43.7.3",
    "electron-builder": "^26.15.3",
    "socket.io-client": "^4.8.3"
  },
  "build": {
    "appId": "cn.jinworld.jinvoice",
    "productName": "JinVoice",
    "directories": {
      "output": "dist_desktop"
    },
    "files": [
      "desktop/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-global-key-listener/**/*"
    ],
    "win": {
      "icon": "client/public/jinvoice-icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
