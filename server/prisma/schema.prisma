// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  rooms        Room[]
}

model SiteAppearance {
  id                 Int      @id @default(1)
  backgroundMode     String   @default("preset")
  backgroundPreset   String   @default("aurora")
  backgroundImageUrl String?
  backgroundMediaType String  @default("image")
  backgroundMediaId String?
  backgroundMediaLibrary String @default("[]")
  backgroundBlur     Int      @default(16)
  backgroundOpacity  Int      @default(68)
  panelOpacity       Int      @default(8)
  panelBlur          Int      @default(22)
  panelGlow          Int      @default(12)
  lgOpacity          Int      @default(12)
  lgBlur             Int      @default(24)
  lgSaturation       Int      @default(120)
  lgBrightness       Int      @default(110)
  lgEdgeHighlight    Int      @default(25)
  lgEdgeHighlightBottom Int   @default(5)
  lgInnerGlow        Int      @default(15)
  lgInsetShadow      Int      @default(20)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Room {
  id           String    @id
  name         String
  password     String?
  isPrivate    Boolean   @default(false)
  isLocked     Boolean   @default(false)
  ownerId      String?
  ownerGuestId String?
  ownerName    String?
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  messages     Message[]

  @@index([ownerId])
  @@index([ownerGuestId])
}

model Message {
  id           Int       @id @default(autoincrement())
  content      String
  imageData    String?
  imageName    String?
  imageWidth   Int?
  imageHeight  Int?
  sender       String
  senderUserId String?
  senderFunId  String?
  roomId       String
  room         Room      @relation(fields: [roomId], references: [id])
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([senderUserId])
  @@index([senderFunId])
  @@index([roomId])
}
